# Copy this file to .env (already gitignored) and fill in real values.
# harness/providers.py loads .env automatically via python-dotenv - no
# manual export needed, and it persists across sessions/shells, unlike a
# one-off `export GEMINI_API_KEY=...` in a single terminal.

GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
